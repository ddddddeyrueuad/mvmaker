# MV 自动生成工坊 · 发行包默认配置（此文件随安装包分发，不含任何密钥）
# 安装后由应用复制到用户数据目录的 config.env，用户可在此填入自己的 Agnes Key。

PORT=3001

# ---- Agnes API（文生图 / 图生视频 / 分镜脚本）----
AGNES_BASE_URL=https://api.agnes-ai.cn/v1
AGNES_AUTH_TYPE=bearer
# 留空：用户首次使用时在界面填入自己的 AGNES_API_KEY（仅保存在本机 config.env）。
# 不在此处写入任何密钥，避免密钥随安装包泄露。
AGNES_API_KEY=
AGNES_CHAT_PATH=/v1/chat/completions
AGNES_T2I_PATH=/v1/images/generations
AGNES_I2V_PATH=/v1/videos
AGNES_VIDEO_POLL_PATH=/agnesapi
AGNES_VIDEO_POLL_PARAM=video_id
AGNES_CHAT_MODEL=agnes-2.5-flash
AGNES_T2I_MODEL=agnes-image-2.1-flash
AGNES_I2V_MODEL=agnes-video-v2.0
AGNES_T2I_SIZE=1024x768
AGNES_VIDEO_FPS=24
AGNES_VIDEO_FRAMES=241
AGNES_COOLDOWN_SEC=10

# ---- MERT 音乐分析 ----
# 发行包（Electron 壳）默认零 Python：本地 MERT 关闭，音乐分析走远程（MVMaker-MERT-Ext 扩展包）
# 或 Mock 兜底。后端启动时若 MERT_REMOTE_URL 留空，会自动探测本机 127.0.0.1:8791 的 MERT 服务，
# 命中即启用本机真实分析——因此安装扩展包后无需手工填写 MERT_REMOTE_URL（留空即可自动识别）。
# 仅当远程服务不在默认地址时，才需在此显式设置 MERT_REMOTE_URL。
MERT_LOCAL=0
MERT_MODEL_PATH=
MERT_PYTHON=
MERT_REMOTE_URL=
MERT_REMOTE_TOKEN=
MERT_REMOTE_TIMEOUT_MS=600000

# ---- 输出参数 ----
OUTPUT_WIDTH=1280
OUTPUT_HEIGHT=720
SEGMENT_SECONDS=10
AUDIO_SAMPLE_RATE=48000
