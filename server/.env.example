# ============================================================
# MV Maker 服务端配置
# Agnes（chat / 文生图 / 图生视频）已确认为 OpenAI 兼容网关：
#   Base URL : https://api.agnes-ai.cn/v1
#   鉴权     : Authorization: Bearer <API Key>
#   模型     : agnes-2.5-flash / agnes-image-2.1-flash / agnes-video-v2.0
# 也可在页面上由用户直接输入 API Key（优先于此处）。
# ============================================================

PORT=3001

# ---------- agnes ----------
AGNES_BASE_URL=https://api.agnes-ai.cn/v1
AGNES_AUTH_TYPE=bearer
AGNES_API_KEY=
# 路径（已按 Agnes 官方文档预设，一般无需改）
AGNES_CHAT_PATH=/v1/chat/completions
AGNES_T2I_PATH=/v1/images/generations
AGNES_I2V_PATH=/v1/videos
# 视频异步轮询：GET <base 去掉 /v1>/agnesapi?video_id=<ID>
AGNES_VIDEO_POLL_PATH=/agnesapi
AGNES_VIDEO_POLL_PARAM=video_id
# 模型名
AGNES_CHAT_MODEL=agnes-2.5-flash
AGNES_T2I_MODEL=agnes-image-2.1-flash
AGNES_I2V_MODEL=agnes-video-v2.0
# 文生图尺寸（Agnes 支持 1024x1024 / 1024x768 / 768x1024）
AGNES_T2I_SIZE=1024x768
# 图生视频参数
AGNES_VIDEO_FPS=24
AGNES_VIDEO_FRAMES=241
# 生成冷却（秒），避免限流
AGNES_COOLDOWN_SEC=10

# ---------- mert(95M) 本地推理 ----------
# 模型已下载在以下目录（auto_map 指向本地 modeling_MERT.py，需 trust_remote_code）
MERT_MODEL_PATH=D:/TEST/music-mert/models/MERT-v1-95M
# 本地推理用的 python 解释器（建议指向带 torch/transformers/librosa 的 venv）
MERT_PYTHON=C:/Users/Administrator/.workbuddy/binaries/python/envs/default/Scripts/python.exe
# 是否启用本地 MERT 推理：1=启用（调用 server/mert_infer.py），0=关闭（用 mock 分析）
MERT_LOCAL=0

# ---------- 合成参数 ----------
OUTPUT_WIDTH=1280
OUTPUT_HEIGHT=720
SEGMENT_SECONDS=10
AUDIO_SAMPLE_RATE=48000
